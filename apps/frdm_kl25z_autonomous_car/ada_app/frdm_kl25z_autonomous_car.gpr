with "config/frdm_kl25z_autonomous_car_config.gpr";
with "../../compiler_flags.gpr";
with "../../zephyr_ada_rts/zephyr_ada_rts.gpr";

project Frdm_Kl25z_Autonomous_Car is
   for Target use Compiler_Flags.Target_Compiler_Selector;
   for Runtime ("Ada") use Zephyr_Ada_Rts'Runtime ("Ada");
   for Languages use ("Ada");

   for Library_Name use "ada_app";
   for Library_Version use Project'Library_Name & ".a." & Frdm_Kl25z_Autonomous_Car_Config.Crate_Version;

   for Source_Dirs use ("src/",
                       "../../third_party/generated_zephyr_ada_bindings/" & Compiler_Flags.Board,
                        "config/");
   for Object_Dir use "obj/" & Frdm_Kl25z_Autonomous_Car_Config.Build_Profile & "/" & Compiler_Flags.Board;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib/" & Compiler_Flags.Board;

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("FRDM_KL25Z_AUTONOMOUS_CAR_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   for Library_Standalone use "standard";

   for Library_Interface use ("Frdm_Kl25z_Autonomous_Car");

   package Compiler is
      for Default_Switches ("Ada") use Frdm_Kl25z_Autonomous_Car_Config.Ada_Compiler_Switches &
                                       Compiler_Flags.Compiler.ADAFLAGS;
   end Compiler;

  --  package Binder is
  --     for Switches ("Ada") use ("-Es"); --  Symbolic traceback
  --  end Binder;

end Frdm_Kl25z_Autonomous_Car;
