# Ada/GNAT compiled output
*.o
*.elf
*.bin
*.map
*.ali
*.su

# GNAT intermediate build files
*.ci
*.cswi
*.lexch
*.stderr
*.stdout

# Libraries
*.a
*.so

# Build directories (match at any depth, not just repo root)
**/obj/
**/lib/
**/build/

# Alire workspace directories (the alire/ subdirectory, not alire.toml)
**/alire/

# Generated source files (Kconfig -> Ada, DTS -> Ada, Alire config)
# These are regenerated by CMake/alr on every build
apps/**/config/

# Python virtual environment
.venv/

# West workspace metadata
.west/

# LaTeX build artifacts
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
doc/**/*.log

# vim backup files
.*.sw[op]
